{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OCR Lab",
  "version": "0.1.0",
  "identifier": "com.oosthash.ocrlab",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "OCR Lab",
        "width": 1120,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
